### prep.subset() v1.0
### 2026-Sep-08

### Helper function to subset a phylogenetic character matrix by taxon, remove invariant characters,
### adjust the ordered-character vector to match, and generate a cost matrix - all in one step.
### Useful for running the same pipeline across multiple matrices (e.g. full, cranial, postcranial)
### and multiple taxonomic subsets without repeating the same lines of code each time.

### Dependencies: remove.invar(), adjust.ord(), cost.matrix() (all from phylodisc)

prep.subset <- function(matrix, taxa, ord = NULL){

	# matrix - phylogenetic character matrix (rows = taxa, columns = characters)
	# taxa   - character vector of taxon names (row names) to subset to, e.g. Lagomorpha
	# ord    - optional vector of ordered characters (as used by adjust.ord);
	#          if NULL, ord adjustment is skipped and $ord will be NULL

	# 1. Subset matrix to the taxa of interest
	matrix_sub <- matrix[row.names(matrix) %in% taxa, , drop = FALSE]

	# 2. Remove invariant characters, keeping track of which columns were removed
	removed_list <- remove.invar(matrix_sub, return_removed = TRUE)
	matrix_new <- removed_list$matrix
	removed <- removed_list$removed

	# 3. Adjust the ordered character vector to match the new column numbering, if supplied
	ord_new <- NULL
	if (!is.null(ord)) {
		ord_new <- adjust.ord(ord, exclude = removed)
	}

	# 4. Generate a cost matrix from the trimmed matrix
	cost_new <- cost.matrix(matrix_new)

	return(list(
		matrix = matrix_new,
		ord = ord_new,
		cost = cost_new,
		removed = removed
	))
}
